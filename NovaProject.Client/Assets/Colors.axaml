<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Primary">#ffd70055</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryDark">#ff7a0030</SolidColorBrush>
    <SolidColorBrush x:Key="Secondary">#ffffb74d</SolidColorBrush>
    <SolidColorBrush x:Key="AccentPrimary">#ff1e1e1e</SolidColorBrush>
    <SolidColorBrush x:Key="AccentPrimaryDark">#ff111111</SolidColorBrush>
    <SolidColorBrush x:Key="Gray100">#ff999999</SolidColorBrush>
    <SolidColorBrush x:Key="Gray200">#ff888888</SolidColorBrush>
    <SolidColorBrush x:Key="Gray300">#ff777777</SolidColorBrush>
    <SolidColorBrush x:Key="Gray400">#ff666666</SolidColorBrush>
    <SolidColorBrush x:Key="Gray500">#ff555555</SolidColorBrush>
    <SolidColorBrush x:Key="Gray600">#ff444444</SolidColorBrush>
    <SolidColorBrush x:Key="Gray700">#ff333333</SolidColorBrush>
    <SolidColorBrush x:Key="Gray800">#ff222222</SolidColorBrush>
    <SolidColorBrush x:Key="Gray900">#ff111111</SolidColorBrush>
    <SolidColorBrush x:Key="DarkGray1">#ff111111</SolidColorBrush>
    <SolidColorBrush x:Key="DarkGray2">#ff1a1a1a</SolidColorBrush>
    <SolidColorBrush x:Key="DarkGray3">#ff1e1e1e</SolidColorBrush>
    <Color x:Key="DarkGray3Color">#ff1e1e1e</Color>
    <Color x:Key="DarkGray2Color">#ff1a1a1a</Color>
    <SolidColorBrush x:Key="DarkGray4">#ff222222</SolidColorBrush>
    <SolidColorBrush x:Key="DarkGray5">#ff2a2a2a</SolidColorBrush>
    <SolidColorBrush x:Key="DarkGray6">#ff3a3a3a</SolidColorBrush>
    <SolidColorBrush x:Key="MainGreen">#ff30C208</SolidColorBrush>
    <SolidColorBrush x:Key="MainRed">#ffC40000</SolidColorBrush>
    <SolidColorBrush x:Key="MainYellow">#ffF0D500</SolidColorBrush>
    <SolidColorBrush x:Key="MainBlue">#ff0094F0</SolidColorBrush>
    <SolidColorBrush x:Key="TrueTransparent">#00ffffff</SolidColorBrush>
    
    <LinearGradientBrush x:Key="ChatBodyBackgroundGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{DynamicResource DarkGray2Color}" Offset="0.0"></GradientStop>
        <GradientStop Color="{DynamicResource DarkGray3Color}" Offset="1.0"></GradientStop>
    </LinearGradientBrush>
</ResourceDictionary>
