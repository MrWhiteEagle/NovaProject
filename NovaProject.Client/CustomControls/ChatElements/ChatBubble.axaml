<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ce="clr-namespace:NovaProject.Client.CustomControls.ChatElements"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NovaProject.Client.CustomControls.ChatElements.ChatBubble"
             x:DataType="ce:ChatBubble"
             x:Name="ChatBubbleRoot">
    <Border
        Padding="10"
        PointerEntered="InputElement_OnPointerEntered"
        PointerExited="InputElement_OnPointerExited"
        Classes="ChatBubble">
    <Grid
        ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto, Auto"
        RowDefinitions="50, Auto"
        IsVisible="{Binding !IsIncoming}">
        <Border 
            Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
            Classes="ChatBubble_AvatarPictureBorder">
            <Image
                Source="/Assets/user.png"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform"/>
        </Border>
        <TextBlock
            Grid.Row="0" Grid.Column="1"
            Classes="ChatBubble_UserNameText"
            Text="{Binding SenderContext.UserName, ElementName=ChatBubbleRoot, FallbackValue=USER_NAME}"/>
        <TextBlock
            Grid.Row="0" Grid.Column="2"
            Classes="ChatBubble_TimeReceivedText"
            IsVisible="{Binding AreActionsVisible, ElementName=ChatBubbleRoot}"
            Text="{Binding MessageDataContext.Timestamp, StringFormat='{}{0:HH:mm}', ElementName=ChatBubbleRoot}"/>
        <Button
            Grid.Row="0" Grid.Column="4"
            Classes="RegularIconButton"
            IsVisible="{Binding AreActionsVisible, ElementName=ChatBubbleRoot}">
            <PathIcon
                Data="{StaticResource DeleteRegular}"/>
        </Button>
        <Button
            Grid.Row="0" Grid.Column="5"
            Classes="RegularIconButton"
            IsVisible="{Binding AreActionsVisible, ElementName=ChatBubbleRoot}">
            <PathIcon
                Data="{StaticResource ArrowReplyRegular}"/>
        </Button>
        <Button
            Grid.Row="0" Grid.Column="6"
            Classes="RegularIconButton"
            IsVisible="{Binding AreActionsVisible, ElementName=ChatBubbleRoot}">
            <PathIcon
                Data="{DynamicResource EditRegular}"/>
        </Button>
        <Button
            Grid.Row="0" Grid.Column="3"
            Classes="RegularIconButton"
            IsVisible="{Binding AreActionsVisible, ElementName=ChatBubbleRoot}">
            <PathIcon
                Data="{StaticResource MoreRegular}"/>
        </Button>
        <Border
            Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6"
            Classes="ChatBubble_MessageContentBlock">
            <TextBlock 
                Text="{Binding MessageDataContext.Content, ElementName=ChatBubbleRoot, FallbackValue=SAMPLE_MESSAGE_CONTENT}"/>
        </Border>
    </Grid>
    </Border>
</UserControl>