<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaProject.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NovaProject.Client.Views.LoginWindow"
             x:DataType="vm:LoginWindowViewModel">
    <Grid IsVisible="{Binding !IsLoggedIn}">
        <StackPanel Spacing="5" VerticalAlignment="Center" IsVisible="{Binding !IsRegistrationToggled}">
            <TextBlock Classes="TitleEmphasized" HorizontalAlignment="Center" Text="Log in"/>
            <TextBlock Classes="SubtitleEmphasized" HorizontalAlignment="Center" Text="To access your local account"/>
            <Panel Margin="0,10"></Panel>
            <TextBox 
                Classes="LoginTextBox"
                Watermark="Username" 
                MaxWidth="500" 
                HorizontalContentAlignment="Center" 
                Text="{Binding UserNameInput, Mode=TwoWay}"/>
            <MaskedTextBox 
                Classes="LoginTextBox"
                Watermark="Password" 
                MaxWidth="500" 
                HorizontalContentAlignment="Center" 
                Text="{Binding PasswordInput, Mode=TwoWay}" 
                RevealPassword="{Binding ShowPasswordInput}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <CheckBox IsChecked="{Binding ShowPasswordInput}"/>
                <TextBlock FontSize="12" VerticalAlignment="Center" Text="Show Password"/>
            </StackPanel>
            <Panel Margin="0,5"></Panel>
            <TextBlock Text="{Binding ResponseMessage, FallbackValue='SAMPLE_ERROR_LOG'}" Foreground="DarkRed" HorizontalAlignment="Center"/>
            <Button HorizontalAlignment="Center" Command="{Binding TryLogInCommand}">Login</Button>
            <Button Command="{Binding ToggleRegisterCommand}" Classes="SimpleTextButton" FontSize="10" HorizontalAlignment="Center">Don't have an account? REGISTER HERE!</Button>
        </StackPanel>
        <StackPanel Spacing="5" VerticalAlignment="Center" IsVisible="{Binding IsRegistrationToggled}">
            <TextBlock Classes="TitleEmphasized" FontSize="16" HorizontalAlignment="Center" Text="Register"/>
            <TextBlock Classes="SubtitleEmphasized" FontSize="12" HorizontalAlignment="Center" Text="Create a new local account"/>
            <Panel Margin="0,15"></Panel>
            <TextBox 
                Classes="LoginTextBox"
                Watermark="Username" 
                MaxWidth="500" 
                HorizontalContentAlignment="Center" 
                Text="{Binding RegisterUserNameInput, Mode=TwoWay}"/>
            <MaskedTextBox 
                Classes="LoginTextBox"
                Watermark="Password" 
                MaxWidth="500" 
                HorizontalContentAlignment="Center" 
                Text="{Binding RegisterPasswordInput, Mode=TwoWay}" 
                RevealPassword="{Binding ShowRegisterPasswordInput}"/>
            <MaskedTextBox 
                Classes="LoginTextBox"
                Watermark="Repeat Password" 
                MaxWidth="500" 
                HorizontalContentAlignment="Center" 
                Text="{Binding RegisterRepeatPasswordInput, Mode=TwoWay}" 
                RevealPassword="{Binding ShowRegisterPasswordInput}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <CheckBox IsChecked="{Binding ShowRegisterPasswordInput}"/>
                <TextBlock FontSize="12" VerticalAlignment="Center" Text="Show Password"/>
            </StackPanel>
            <Panel Margin="0,5"></Panel>
            <TextBlock Text="{Binding ResponseMessage, FallbackValue='SAMPLE_ERROR_LOG'}" Foreground="DarkRed" HorizontalAlignment="Center"/>
            <Button HorizontalAlignment="Center" Command="{Binding TryRegisterCommand}">Register</Button>
            <Button Command="{Binding ToggleRegisterCommand}" Classes="SimpleTextButton" FontSize="10" HorizontalAlignment="Center">Have an account? Log in HERE</Button>
        </StackPanel>
    </Grid>
</UserControl>
